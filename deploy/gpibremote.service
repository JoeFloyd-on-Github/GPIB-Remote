[Unit]
Description=GPIB-Remote server (plain TCP 9000, LAN/VPN only)
After=network-online.target systemd-udevd.service
Wants=network-online.target

[Service]
Type=simple
User=gpibremote
Group=gpib
WorkingDirectory=/opt/gpibremote/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/gpibremote/app/server
# /dev/gpib0 is created by udev when the adapter is configured; wait for it (up to 30 s).
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -c /dev/gpib0 ] && exit 0; sleep 1; done; echo "/dev/gpib0 missing"; exit 1'
ExecStart=/opt/gpibremote/venv/bin/python -m gpibremote --backend linuxgpib --port 9000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
