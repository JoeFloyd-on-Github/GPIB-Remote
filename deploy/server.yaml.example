# GPIB-Remote server configuration. install.sh copies this to /etc/gpibremote/server.yaml
# if that file doesn't exist yet; edit the copy, then: sudo systemctl restart gpibremote
#
# Plain TCP, no TLS: keep the server on a LAN or behind a VPN.

listen:
  host: 0.0.0.0
  port: 9000

boards:
  - board: 0            # /dev/gpib0 (NI GPIB-USB-HS)
    backend: linuxgpib
  # A simulated bench instead, for testing without hardware:
  # - board: 0
  #   backend: sim
  #   instruments: {5: agilent.e3631a, 6: hp.6632a, 22: hp.3457a}

# Instances and types added at run time. A local git repository (branch device-data); every
# change is a commit. The server never contacts GitHub: copy the history there from a PC with
# scripts/save_device_data.py.
data_dir: /var/lib/gpibremote/data

git:
  enabled: true

locks:
  idle_timeout: 15min   # a control lock is released after this long without activity

log_level: INFO
